# Root .gitignore for monorepo with backend and frontend

# Ignore environment and credentials
*.env
**/.env
.env.local
.env.*.local

# Node / frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/build/
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# Maven / Java
/backend/target/
/backend/.mvn/
/backend/mvnw
/backend/mvnw.cmd
/backend/logs/
**/target/
*.log
*.class
*.jar
*.war
*.ear

# IDE / editor
/.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# System
.DS_Store
Thumbs.db
desktop.ini

# Build and cache
node_modules/
**/node_modules/
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
